# ---------------------------------------------------------------------------
# Database (Phase 1 uses SQLite; swap the provider in prisma/schema.prisma to
# move to Postgres without touching any application code)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# 32+ byte secret used to sign session cookies and encrypt stored OAuth tokens.
# In production the app REFUSES to encrypt tokens if this is shorter than 32
# characters, rather than storing them weakly. Changing it makes every stored
# token undecryptable and forces a reconnect, so set it once and keep it.
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Production requires a real sign-in. Every page and API route resolves its
# data through a session cookie backed by a row in the Session table, and a
# request without one gets a redirect to /login or a 401 — there is no
# fallback to "the workspace owner" and no environment variable that restores
# one. Each browser that signs in gets its own session; signing out of one
# leaves the others alone.
#
# To give an existing account a password (this is how the first owner signs
# in — the account predates the login screen and has no password yet):
#     npm run auth:set-password -- --email you@example.com --generate
# It only sets a password on an account that already exists. It never creates
# one, and it never touches connections, tokens or orders.
#
# SINGLE_USER_MODE only affects `npm run dev`, where it is on by default so a
# developer is not asked to sign in on every restart. It is read only when
# NODE_ENV is not "production" and is completely inert in a production build —
# setting it there does nothing. Set it to "false" to exercise the real login
# flow locally.
# SINGLE_USER_MODE="false"

# Whether a visitor can create their own account at /register.
#
# Default: open. A new account gets its own empty workspace and can see
# nothing belonging to anyone else — every query is scoped by user id — but a
# deployment run for one seller should still close it.
# ALLOW_REGISTRATION="false"

# ---------------------------------------------------------------------------
# Data retention  (optional; unset = keep everything)
# ---------------------------------------------------------------------------
# The verbatim eBay payload stored per order is the largest concentration of
# buyer personal data in the database (name, email, phone, address). It exists
# so a field mapping added later can be re-applied to orders already imported,
# which stops being useful once an order is old.
#
# Clearing it leaves the order, its totals, its sheet row and its history
# intact; only the ability to re-map that order against a NEW field is lost.
# RAW_PAYLOAD_RETENTION_DAYS="180"

# Days to keep run logs and per-order sync results before deleting them.
# SYNC_HISTORY_RETENTION_DAYS="365"

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# Two ways to run scheduled syncs; use either, or both (they are safe
# together, because claiming a job is an atomic compare-and-swap):
#
#   1. A long-running process:  npm run worker
#   2. An external cron calling POST /api/jobs/tick
#
# The tick endpoint is DISABLED unless CRON_SECRET is set — an open trigger
# would let anyone burn your eBay and Google quota. Pass it as
# `Authorization: Bearer <secret>`, an `x-cron-secret` header, or ?secret=.
CRON_SECRET=""

# How often the long-running worker polls for due work.
# WORKER_INTERVAL_MS="30000"

# ---------------------------------------------------------------------------
# eBay OAuth + API
# ---------------------------------------------------------------------------
# SANDBOX or PRODUCTION. Must match the keyset the credentials below came from.
EBAY_ENVIRONMENT="SANDBOX"

# From https://developer.ebay.com -> Application Keys ("App ID" / "Cert ID").
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# IMPORTANT: eBay's authorization-code flow does NOT take a URL here. It takes
# your application's RuName (e.g. "Your-Company-AppName-PRD-a1b2c3d4e-f5g6h7i8").
# Create it under "User Tokens" -> "Get a Token from eBay via Your Application",
# and set its "Your auth accepted URL" to:
#     http://localhost:3000/api/auth/ebay/callback
# (use your real https origin in production).
EBAY_RU_NAME=""

# Set to false if your keyset does not have commerce.identity.readonly enabled.
# When false the app cannot display the seller's eBay username and falls back
# to the seller id. eBay rejects the entire consent request if an unavailable
# scope is requested, so flip this rather than guessing.
EBAY_REQUEST_IDENTITY_SCOPE="true"

# --- Marketplace Account Deletion notifications -----------------------------
# eBay requires every production application to expose an endpoint it can call
# when a seller closes their account. This app serves it at:
#
#     <APP_URL>/api/ebay/marketplace-account-deletion
#
# Register it under developer.ebay.com -> Alerts & Notifications ->
# "Marketplace Account Deletion". You enter two things there, and BOTH must
# match these variables exactly or eBay's validation fails.
#
# 1. A verification token you invent: 32-80 characters, letters/digits/_/-
#    It is never sent anywhere. It is hashed together with the challenge code
#    to prove that whatever serves the URL also knows this secret.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=""

# 2. The endpoint URL, character for character as registered with eBay. It is
#    part of the hash, so a trailing slash or http-vs-https changes the answer
#    and verification fails with no useful error.
#
#    It must be a public HTTPS URL in production — eBay calls it from the
#    internet and cannot reach localhost. For local testing, point a tunnel
#    (ngrok, cloudflared) at this app and use the tunnel's HTTPS URL here.
EBAY_MARKETPLACE_DELETION_ENDPOINT=""

# Check the two values above without deploying:
#     npm run ebay:verify-deletion
#     npm run ebay:verify-deletion -- --url https://your-host/api/ebay/marketplace-account-deletion

# --- API behaviour (optional; sensible defaults are built in) ---------------
# Minimum gap between outbound eBay requests, per connection.
# EBAY_MIN_REQUEST_INTERVAL_MS="120"
# Attempts per request, including the first (429/5xx/network are retried).
# EBAY_MAX_ATTEMPTS="4"
# EBAY_REQUEST_TIMEOUT_MS="30000"
# Max shipping-fulfillment lookups per import run (one API call each).
# EBAY_FULFILLMENT_CALL_BUDGET="120"

# ---------------------------------------------------------------------------
# Google OAuth + Sheets
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application.
#
# Enable both "Google Sheets API" and "Google Drive API" on the project, and
# add this exact string under "Authorized redirect URIs":
#     http://localhost:3000/api/auth/google/callback
# (your real https origin in production). Unlike eBay, this IS a literal URL
# and must match character for character.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Defaults to APP_URL + /api/auth/google/callback.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Scope control. With "true" (the default) the app requests read+write on
# spreadsheets, so the user consents once rather than again when syncing is
# implemented. Nothing in the current phase writes. Set to "false" to request
# spreadsheets.readonly instead.
GOOGLE_REQUEST_WRITE_SCOPE="true"

# --- API behaviour (optional; sensible defaults are built in) ---------------
# GOOGLE_MIN_REQUEST_INTERVAL_MS="80"
# GOOGLE_MAX_ATTEMPTS="4"
# GOOGLE_REQUEST_TIMEOUT_MS="30000"

# --- Public legal pages -------------------------------------------------------
# Shown on /privacy-policy, which is public and requires no session.
#
# The privacy policy names a real operator and a real contact address: whoever
# deploys this is the data controller. An invented address is worse than none,
# so these are configuration rather than hard-coded — with no email set, the
# page says so plainly instead of promising a route nobody reads.
PRIVACY_CONTACT_EMAIL=""
PRIVACY_OPERATOR_NAME=""
