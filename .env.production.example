# =============================================================================
# PRODUCTION environment
# =============================================================================
# Set these in your hosting platform's secret manager (Vercel/Railway/Render
# environment variables, Docker secrets, systemd EnvironmentFile, …).
#
# Do NOT commit a filled-in copy of this file. `.env*` is gitignored except
# for the two `.example` templates.
#
# The application refuses to start cleanly if a blocker below is missing:
# src/lib/production-check.ts runs at boot and prints what is wrong. There is
# no fallback to demo data — an unconfigured deployment reports a
# configuration error instead of showing something that looks like data.
# =============================================================================

NODE_ENV="production"

# --- Application -------------------------------------------------------------
# Public HTTPS origin. OAuth redirect URIs are derived from it, and the session
# cookie is only marked Secure when this is https.
# BLOCKER if missing, not HTTPS, or pointing at localhost.
APP_URL="https://sync.yourdomain.com"

# 32+ random characters. Derives the AES-256-GCM key that encrypts stored eBay
# and Google tokens. Changing it makes every stored token undecryptable and
# forces all users to reconnect, so set it once and keep it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# BLOCKER if missing or shorter than 32 characters.
AUTH_SECRET=""

# This application has NO sign-in screen. In production every request is
# rejected with 401 unless you explicitly opt in to single-user mode, which
# asserts that the host is not reachable by anyone else (bound to localhost,
# behind a VPN, or behind a reverse proxy that authenticates).
# Leave unset until real authentication is added.
# SINGLE_USER_MODE="true"

# --- Database ----------------------------------------------------------------
# SQLite CANNOT be used on Vercel, Netlify, or any serverless host:
#   * the filesystem is read-only apart from /tmp, and SQLite must write
#   * every invocation may be a fresh container, so the file does not persist
#   * prisma/*.db is gitignored, so the file is not even in the deployment
# Symptoms are "SQLITE_CANTOPEN: unable to open database file" or
# "The table main.User does not exist in the current database".
#
# Use a hosted Postgres. Any of these work; Neon is the default Vercel offers:
#   Vercel  -> Storage tab -> Create Database -> Postgres (Neon)
#   Neon    -> neon.tech
#   Supabase-> supabase.com (use the "Connection pooling" URI)
#
# Serverless opens many short-lived connections, so use the POOLED connection
# string here. Neon's pooled host contains "-pooler"; Supabase's is port 6543.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The datasource provider in prisma/schema.prisma is derived from the URL above
# by scripts/sync-db-provider.mjs, which runs as the first step of the build.
# A Postgres URL produces a Postgres client; a file: URL produces SQLite. There
# is nothing to edit by hand when moving between local and production.
#
# Create the tables once, from your own machine, before the first deploy:
#   set DATABASE_URL=<the same Postgres URL>
#   npm run db:deploy

# --- eBay --------------------------------------------------------------------
# From developer.ebay.com → Application Keys. These must be the PRODUCTION
# keyset, not sandbox.
EBAY_ENVIRONMENT="PRODUCTION"   # BLOCKER if anything else in production
EBAY_CLIENT_ID=""               # "App ID (Client ID)"
EBAY_CLIENT_SECRET=""           # "Cert ID (Client Secret)" — 44 chars, ends in a 12-char group
EBAY_RU_NAME=""                 # BLOCKER if missing: eBay redirects to a RuName, not a URL

# Create the RuName at: developer.ebay.com → User Tokens →
# "Get a Token from eBay via Your Application" → Add eBay Redirect URL, with
# "Your auth accepted URL" set to:
#     https://sync.yourdomain.com/api/auth/ebay/callback

# Set to false if your keyset does not have commerce.identity.readonly enabled.
EBAY_REQUEST_IDENTITY_SCOPE="true"

# --- Google ------------------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Enable BOTH the Google Sheets API and the Google Drive API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must match an "Authorized redirect URI" in Google Cloud character for
# character. BLOCKER if it points at localhost in production.
GOOGLE_REDIRECT_URI="https://sync.yourdomain.com/api/auth/google/callback"

GOOGLE_REQUEST_WRITE_SCOPE="true"

# --- Background worker -------------------------------------------------------
# Scheduled syncs need ONE of these to be running. Both are safe together:
#   1. A long-running process:  npm run worker
#   2. A platform cron calling: POST /api/jobs/tick
#
# The tick endpoint stays DISABLED unless CRON_SECRET is set — an open trigger
# would let anyone burn the seller's eBay and Google quota. Present it as
# `Authorization: Bearer <secret>`, an `x-cron-secret` header, or ?secret=.
CRON_SECRET=""

# WORKER_INTERVAL_MS="30000"

# --- Health endpoint ---------------------------------------------------------
# GET /api/health reports dependency status without exposing any secret value.
# Falls back to CRON_SECRET when unset; refuses to answer if neither is set.
# HEALTH_SECRET=""

# --- Data retention (optional; unset = keep everything) -----------------------
# The verbatim eBay payload per order is the largest concentration of buyer
# personal data in the database. Clearing it leaves the order, its totals, its
# sheet row and its history intact — only re-mapping that order against a NEW
# field is lost.
# RAW_PAYLOAD_RETENTION_DAYS="180"
# SYNC_HISTORY_RETENTION_DAYS="365"

# --- eBay / Google API tuning (optional; defaults are built in) ---------------
# EBAY_MIN_REQUEST_INTERVAL_MS="120"
# EBAY_MAX_ATTEMPTS="4"
# EBAY_REQUEST_TIMEOUT_MS="30000"
# EBAY_FULFILLMENT_CALL_BUDGET="120"
# GOOGLE_MIN_REQUEST_INTERVAL_MS="80"
# GOOGLE_MAX_ATTEMPTS="4"
# GOOGLE_REQUEST_TIMEOUT_MS="30000"

# --- eBay Marketplace Account Deletion notifications -------------------------
# Required for a production eBay application. Register the endpoint at
# developer.ebay.com → Alerts & Notifications → Marketplace Account Deletion.
# Both values must match what you enter there exactly.
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=""
EBAY_MARKETPLACE_DELETION_ENDPOINT="https://sync.yourdomain.com/api/ebay/marketplace-account-deletion"

# --- Public legal pages -------------------------------------------------------
# Shown on /privacy-policy, which is public and requires no session.
#
# The privacy policy names a real operator and a real contact address: whoever
# deploys this is the data controller. An invented address is worse than none,
# so these are configuration rather than hard-coded — with no email set, the
# page says so plainly instead of promising a route nobody reads.
PRIVACY_CONTACT_EMAIL=""
PRIVACY_OPERATOR_NAME=""
